{
  "name": "wave-dash-clone",
  "version": "2.0.0",
  "private": true,
  "description": "Wave Dash — production-ready one-button canvas wave game (Next.js 16 shell + self-contained game)",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build:css": "tailwindcss -c tailwind.config.js -i ./src/game.tailwind.css -o ./public/assets/css/game.css --minify",
    "predev": "npm run build:css",
    "prebuild": "npm run build:css",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
